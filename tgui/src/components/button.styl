context = selector()

buttoncolor(selector, color)
  &.{selector}
    transition: background-color 0.5s
    background-color: color
  &.{selector}.active:hover,
  &.{selector}.active:focus
    transition: background-color 0.25s
    background-color: lighten(color, button-lighten-hover)
    outline: 0

span.button
  @extend {context} $fontReset
  display: inline-block
  vertical-align: middle
  min-height: 20px
  line-height: @min-height - 3px
  padding: 0 5px
  white-space: nowrap

  border: 1px solid button-color-border

  .fa
    padding-right: 2px

  buttoncolor(normal, button-color-normal)
  buttoncolor(disabled, button-color-disabled)
  buttoncolor(selected, button-color-selected)
  buttoncolor(toggle, button-color-selected)
  buttoncolor(caution, button-color-caution)
  buttoncolor(danger, button-color-danger)

  &.gridable
    width: 125px
    margin: 2px 0
    &.center
      text-align: center
      width:75px
span:not(.button) + span.button
  margin-left: 5px

span.button + span:not(.button)
  margin-left: 5px

// PDA (interfaces/pda.ract), laid out after modern tg's NtOS: a status strip, cards, programs as a plain icon list
div.pda
  font-family: Consolas, 'DejaVu Sans Mono', monospace
  span.button
    font-family: inherit
div.pda-status
  display: flex
  justify-content: space-between
  align-items: center
  margin: -4px -4px 0
  padding: 3px 8px
  background-color: alpha(#000, 0.35)
  border-bottom: 1px solid alpha(#fff, 0.08)
  font-weight: bold
  .pda-os
    font-weight: normal
    color: alpha(#fff, 0.35)
    margin-left: 6px
  .pda-light, .fa-signal
    font-size: 14px
  .pda-light
    color: #ffd84d
  .pda-actions
    display: flex
    align-items: center
    gap: 6px
div.pda-line
  display: flex
  align-items: center
  gap: 6px
  padding: 1px 4px
  min-height: 20px
// one message on the Messages screen: who on top, the text under it; sent ones edged green, received ones blue
div.pda-msg
  margin: 4px 2px
  padding: 2px 6px
  border-left: 3px solid #4a84c0
  background-color: alpha(#fff, 0.04)
  word-wrap: break-word
  &.pda-out
    border-left-color: #5a9e5a
  .pda-msg-who
    display: flex
    align-items: center
    gap: 4px
    font-weight: bold
    color: alpha(#fff, 0.6)
    span.button.pda-link
      flex: 0 1 auto
      padding: 0 2px
// icon-only button
span.button.pda-icon
  margin-left: 0
  padding: 0 4px
  .fa
    padding-right: 0
// a program or contact: text with an icon, no button box, lit on hover
span.button.pda-link
  display: block
  flex: 1
  margin: 0
  padding: 1px 4px
  text-align: left
  border-color: transparent
  overflow: hidden
  text-overflow: ellipsis
  &.normal
    background-color: transparent
  &.normal.active:hover, &.normal.active:focus
    background-color: alpha(#fff, 0.1)
  .fa
    width: 20px
    text-align: center
    padding-right: 4px
